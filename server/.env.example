# Copy to .env (next to telemetry_server.py) and fill in. Variables set in the real environment win over this file.

# Where the server listens. SERVER_PORT is the one your host (e.g. a Pterodactyl-style panel) gives you.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Signs logins and bot tokens: at least 32 characters. Make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Left empty, one is made and saved next to the database on first start.
TELEMETRY_SECRET=

# Where bots, keys, roles and reports are stored (a SQLite file). Keep it private and back it up.
TELEMETRY_DB=telemetry.db

# Yapin' user IDs of the owners, comma separated. Owners can do everything in the panel.
# Managers and approvers are added from the panel's Team tab.
TELEMETRY_OWNERS=

# The public https address of this server, no trailing slash. Used for the login redirect and secure cookies.
TELEMETRY_PANEL_URL=https://yapper-py.rustdactyl.tech

# Shown to bots that are not approved yet.
TELEMETRY_SUPPORT_URL=https://www.yapin.gg/invite/pythonlibrary

# "Log in with Yapin'". Register this server as an app on Yapin' and copy its details here.
# The redirect URI to register is TELEMETRY_PANEL_URL + /auth/callback.
YAPIN_CLIENT_ID=
YAPIN_CLIENT_SECRET=
YAPIN_AUTHORIZE_URL=
YAPIN_TOKEN_URL=
YAPIN_USERINFO_URL=
# Only if different from TELEMETRY_PANEL_URL + /auth/callback:
YAPIN_REDIRECT_URI=
YAPIN_SCOPE=identify
# Which fields of the user-info response hold the user's ID and name (dots reach into objects: user.id).
YAPIN_USER_ID_FIELD=id
YAPIN_USERNAME_FIELD=username

# Seconds a bot token lasts.
TELEMETRY_TOKEN_TTL=3600
# Bots must send their private key (TELEMETRY_KEY). Set to 0 only while older yapper.py versions still need to work.
TELEMETRY_REQUIRE_KEY=1
# 1 when a reverse proxy in front of this server sets X-Forwarded-For (used for rate limits only).
TELEMETRY_TRUST_PROXY=0
# Defaults to on when TELEMETRY_PANEL_URL starts with https://.
TELEMETRY_COOKIE_SECURE=
# 1 lets anyone on this machine log in as any user (/dev-login?user=ID). For local testing only.
TELEMETRY_DEV_LOGIN=0
